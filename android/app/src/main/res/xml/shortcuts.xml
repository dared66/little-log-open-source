        android:icon="@drawable/shortcut_diaper"
        android:shortcutShortLabel="@string/shortcut_diaper">
        <intent android:action="app.littlelog.quick.diaper"
            android:targetPackage="app.littlelog.little_log"
            android:targetClass="app.littlelog.little_log.MainActivity"/>
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding android:key="feature" android:value="@array/voice_feature_diaper"/>
        </capability-binding>
    </shortcut>
