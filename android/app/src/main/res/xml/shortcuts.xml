    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.littlelog.little_log" android:targetClass="app.littlelog.little_log.MainActivity">
            <url-template android:value="littlelog://voice/{feature}"/>
            <parameter android:name="feature" android:key="feature" android:required="true" app:shortcutMatchRequired="true"/>
        </intent>
        <intent android:action="android.intent.action.MAIN" android:targetPackage="app.littlelog.little_log" android:targetClass="app.littlelog.little_log.MainActivity"/>
    </capability>
    <capability android:name="custom.actions.intent.ADD_DIAPER" app:queryPatterns="@array/voice_queries_add_diaper">
