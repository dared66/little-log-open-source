            <url-template android:value="littlelog://voice/add_diaper{?kind}"/>
            <parameter android:name="kind" android:key="kind" android:mimeType="https://schema.org/Text" android:required="true"/>
        </intent>
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.littlelog.little_log" android:targetClass="app.littlelog.little_log.MainActivity" android:data="littlelog://voice/open_diaper"/>
